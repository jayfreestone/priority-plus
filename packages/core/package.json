{
  "name": "@priority-plus/core",
  "version": "0.0.0-semantically-released",
  "description": "Framework-agnostic priority plus layout core.",
  "type": "module",
  "sideEffects": ["./dist/prelayout.iife.js"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./prelayout": {
      "types": "./dist/prelayout.d.ts",
      "import": "./dist/prelayout.js"
    },
    "./prelayout.iife.js": "./dist/prelayout.iife.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/calculate.ts",
    "src/dom.ts",
    "src/index.ts",
    "src/partition.ts",
    "src/prelayout.iife.ts",
    "src/prelayout.ts",
    "src/session.ts",
    "src/toggle.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "devDependencies": {
    "@vitest/browser-playwright": "^4.0.14",
    "playwright": "^1.57.0",
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
