{
  "name": "priority-plus",
  "version": "0.0.0-semantically-released",
  "description": "A modern implementation of the priority plus navigation pattern.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/priority-plus.d.ts",
      "import": "./dist/priority-plus.js"
    }
  },
  "types": "./dist/priority-plus.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "vite playground",
    "dev-build": "vite build playground",
    "dev-preview": "vite preview --outDir playground/dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayfreestone/priority-plus.git"
  },
  "author": {
    "name": "Jay Freestone",
    "email": "mail@jayfreestone.com",
    "url": "https://www.jayfreestone.com/"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jayfreestone/priority-plus/issues"
  },
  "homepage": "https://github.com/jayfreestone/priority-plus#readme",
  "devDependencies": {
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3",
    "vite": "^8.0.11"
  },
  "keywords": [
    "navigation",
    "menu",
    "responsive",
    "priority"
  ],
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "assets": [
            "dist/**/*"
          ]
        }
      ]
    ]
  }
}
